{
  "name": "@posnepal/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types, enums, and helpers for POS Nepal apps",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
