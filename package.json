{
  "name": "posnepal",
  "version": "1.0.0",
  "private": true,
  "description": "POS Nepal — multi-tenant POS, inventory, and billing workspace",
  "scripts": {
    "dev": "pnpm --filter @posnepal/shared build && pnpm --parallel --filter @posnepal/frontend --filter @posnepal/backend dev",
    "dev:frontend": "pnpm --filter @posnepal/frontend dev",
    "dev:backend": "pnpm --filter @posnepal/backend start:dev",
    "dev:desktop": "pnpm --filter @posnepal/shared build && pnpm --filter @posnepal/desktop dev",
    "build": "pnpm --filter @posnepal/shared build && pnpm --filter @posnepal/backend build && pnpm --filter @posnepal/frontend build",
    "build:shared": "pnpm --filter @posnepal/shared build",
    "build:frontend": "pnpm --filter @posnepal/frontend build",
    "build:backend": "pnpm --filter @posnepal/backend build",
    "build:desktop": "pnpm --filter @posnepal/shared build && pnpm --filter @posnepal/desktop build",
    "lint": "pnpm --recursive lint",
    "seed:admin": "pnpm --filter @posnepal/backend seed:admin",
    "seed:user": "pnpm --filter @posnepal/backend seed:user"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
