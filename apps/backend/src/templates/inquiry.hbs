<html>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>New Inquiry Received</title>
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
      "Helvetica Neue", Arial, sans-serif; background-color: #f1f5f9; margin: 0;
      padding: 40px 20px; color: #0f172a; } .email-container { max-width: 600px;
      margin: 0 auto; background-color: #ffffff; border-radius: 8px; border: 1px
      solid #e2e8f0; box-shadow: 0 14px 34px rgba(15, 23, 42, 0.08); overflow:
      hidden; } .header { background-color: #0054a8; color: #ffffff; padding:
      24px; text-align: center; } .header h1 { margin: 0; font-size: 22px;
      font-weight: 600; } .content { padding: 32px 24px; } .content p {
      font-size: 15px; line-height: 1.6; color: #334155; margin: 0 0 16px 0; }
      .inquiry-box { background-color: #f8fafc; border: 1px solid #e2e8f0;
      border-radius: 8px; padding: 20px; margin-top: 20px; } .inquiry-box p {
      margin: 8px 0; font-size: 14px; color: #0f172a; } .label { font-weight:
      600; color: #475569; } .message-box { margin-top: 16px; padding: 16px;
      border-radius: 6px; background-color: #ffffff; border: 1px dashed #cbd5f5;
      font-size: 14px; color: #334155; white-space: pre-line; } .footer {
      margin-top: 32px; padding-top: 20px; border-top: 1px solid #e2e8f0;
      text-align: center; } .footer p { font-size: 13px; color: #64748b; margin:
      6px 0; } .footer a { color: #0054a8; text-decoration: none; font-weight:
      500; }
    </style>
  </head>

  <body>
    <div class='email-container'>
      <div class='header'>
        <h1>New Inquiry Received</h1>
      </div>

      <div class='content'>
        <p>You have received a new inquiry from your website.</p>

        <div class='inquiry-box'>
          <p><span class='label'>Name:</span> {{fullName}}</p>
          <p><span class='label'>Email:</span> {{email}}</p>
          <p><span class='label'>Phone:</span> {{phone}}</p>
          <p><span class='label'>Est. Budget:</span> {{estBudget}}</p>
          <p><span class='label'>Timing:</span> {{timing}}</p>
          <div class='message-box'>
            {{message}}
          </div>
        </div>

        <div class='footer'>
          <p>
            Reply directly to this email or contact the user at<br />
            <a href='mailto:{{email}}'>{{email}}</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>