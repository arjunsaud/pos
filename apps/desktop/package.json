{
  "name": "@posnepal/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "POS Nepal desktop app (Electron)",
  "main": "dist/presentation/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build": "pnpm build:main && pnpm build:ui",
    "dev": "pnpm build:main && node scripts/dev.mjs",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@posnepal/shared": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "tailwindcss": "^4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
